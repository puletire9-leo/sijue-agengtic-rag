# ═══════════════════════════════════════════════════════════════
# SuperMew 环境变量配置
# 复制为 .env 后取消注释并填入真实值
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════
# 方案 A: DeepSeek (推荐 — 全 flash，¥0.0099/次)
#   1M 上下文 + 384K 输出 + 思考模式 + prompt 缓存
#   ¥1.0/百万输入  ¥2.0/百万输出
# ═══════════════════════════════════════════════════════
ARK_API_KEY= #sk-
MODEL= #deepseek-v4-flash
BASE_URL= #https://api.deepseek.com
GRADE_MODEL= #deepseek-v4-flash
FAST_MODEL= #deepseek-v4-flash

# ═══════════════════════════════════════════════════════
# 方案 B: 豆包 3 级路由 (备选，¥0.0107/次)
#   Tier 1 pro: ¥0.64/百万输入 ¥16/百万输出
#   Tier 2 lite: ¥0.12/百万输入 ¥3.6/百万输出
#   Tier 3 flash: ¥0.03/百万输入 ¥1.5/百万输出
# ═══════════════════════════════════════════════════════
# ARK_API_KEY= #
# MODEL= #doubao-seed-2.0-pro-260215
# BASE_URL= #https://ark.cn-beijing.volces.com/api/v3
# GRADE_MODEL= #doubao-seed-2.0-lite-260215
# FAST_MODEL= #doubao-seed-1.6-flash-250828

# ── 本地 Embedding 模型 ──
EMBEDDING_MODEL= #BAAI/bge-m3
EMBEDDING_DEVICE= #cpu
DENSE_EMBEDDING_DIM= #1024

# ── Rerank API ──
RERANK_MODEL= #jina-reranker-v3
RERANK_BINDING_HOST= #https://api.jina.ai/v1/rerank
RERANK_API_KEY= #jina_

# ── Milvus ──
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ── PostgreSQL ──
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/langchain_app

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=supermew
REDIS_CACHE_TTL_SECONDS=300

# ── Agentic RAG ──
MAX_ITERATIONS=5
MAX_RETRY_ITERATIONS=3
COMPRESSION_THRESHOLD=80000
COMPRESSION_THRESHOLD_AGENT=80000

# ── Memory ──
MEMORY_SESSION_TTL=86400
MEMORY_SHORT_TERM_DAYS=30
MEMORY_LONG_TERM_ENABLED=true

# ── Guardrails ──
GUARDRAIL_QUERY_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true

# ── Weather ──
AMAP_WEATHER_API= #https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY= #

# ── Open WebUI 对接 ──
OPENAI_COMPATIBLE_API_KEY=supermew-api-key-xxx

# ── 安全 ──
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=supermew-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=600000

# ── CORS ──
CORS_ORIGINS=*

# ── 可选：结构化日志 ──
STRUCTURED_LOG=false

# ── 可选：OpenTelemetry ──
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ── 可选：Metrics 认证 ──
# METRICS_AUTH_TOKEN=your-secret-token
